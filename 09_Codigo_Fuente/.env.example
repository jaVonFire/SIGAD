# Archivo de ejemplo — copiar como .env y ajustar.
PORT=3000
DB_PATH=data/sigad.sqlite
UPLOADS_DIR=uploads
SESSION_TTL_DAYS=7
MAX_UPLOAD_MB=10
MAX_TEXT_CHARS=300000

# --- Integración LLM opcional (compat. API OpenAI) ---
# Si se define AI_API_BASE y AI_API_KEY, el asistente sintetiza respuestas
# condicionadas por el contexto recuperado (RAG + LLM). Sin estas variables
# el sistema funciona 100% local con RAG extractivo (sin claves ni costos).
# AI_API_BASE=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini